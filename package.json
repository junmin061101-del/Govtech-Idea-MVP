{
  "name": "careos-mvp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "data:fetch": "node scripts/fetch-boundaries.mjs && node scripts/fetch-mois-population.mjs && node --env-file=.env.local scripts/fetch-seoul-childcare.mjs",
    "data:build": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-data.mjs",
    "data:mock-unmet": "node scripts/build-mock-unmet.mjs",
    "data:snapshot": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning --import ./scripts/lib/register-alias.mjs scripts/build-snapshot.mjs"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.46.0",
    "next": "14.2.35",
    "react": "^18",
    "react-dom": "^18",
    "react-kakao-maps-sdk": "^1.2.2",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^2.1.9"
  }
}
