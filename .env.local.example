# 카카오맵 JavaScript 키 (카카오 개발자 콘솔 > 앱 > 플랫폼 > Web에 접속 도메인 등록 필요)
NEXT_PUBLIC_KAKAO_MAP_API_KEY=your_kakao_javascript_key_here

# 서울 열린데이터광장 일반 인증키 (데이터 수집 스크립트 전용, 화면에는 쓰지 않음)
SEOUL_OPEN_DATA_API_KEY=your_seoul_open_data_general_key_here

# Firebase 웹 앱 설정 (Firebase 콘솔 > 프로젝트 설정 > 내 앱). 비워 두면 시연 모드(브라우저 저장)로 동작
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# 1이면 로컬 에뮬레이터(Auth 9099, Firestore 8080)에 붙는다 (npm run dev:emulators)
NEXT_PUBLIC_FIREBASE_EMULATORS=
